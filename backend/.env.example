# Django Settings
DJANGO_SECRET_KEY=replace-this-for-local-development-secret-key
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_PRICES=stock-prices
KAFKA_TOPIC_EVENTS=stock-events
KAFKA_CONSUMER_GROUP_LIVE=stock-event-live-group

# Redis / Channel Layer Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Frontend Configuration
FRONTEND_ORIGIN=http://localhost:3000

# Replay Defaults
DEFAULT_REPLAY_LIMIT=50
